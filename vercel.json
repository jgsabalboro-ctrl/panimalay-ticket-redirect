    },
    {
      "src": "/",
      "dest": "https://script.google.com/macros/s/AKfycbym1psX1O0vqMUb6PfzwuHp72VK-nm70h7vU0YNTFLaeOFnndHEidHJa_Uwfhv7Cab5/exec?forward=1",
